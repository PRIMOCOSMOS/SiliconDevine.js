"], "outputs": ["combine:out"]}, "attention": {"name": "MLA · 压缩潜变量注意力", "description": "按源码组合的结构模板；同构实例拥有各自权重。", "source": "DeepSeek-V3 / inference/model.py", "tensors": [{"id": "input", "shape": ["B", "T", 7168], "dtype": "logical", "role": "input", "representation": "aggregate", "semantic": "输入"}, {"id": "q_down:out", "shape": ["B", "T", 1536], "dtype": "logical", "role": "activation", "representation": "aggregate", "semantic": "q_down:out"}, {"id": "q_down:W", "shape": [1536, 7168], "dtype": "logical", "role": "parameter", "representation": "aggregate", "semantic": "q_down:W"}, {"id": "q_norm:out", "shape": ["B", "T", 1536], "dtype": "logical", "role": "activation", "representation": "aggregate", "semantic": "q_norm:out"}, {"id": "q_norm:gamma", "shape": [1536], "dtype": "logical", "role": "parameter", "representation": "aggregate", "semantic": "q_norm:gamma"}, {"id": "q_up:out", "shape": ["B", "T", 128, 192], "dtype": "logical", "role": "activation", "representation": "aggregate", "semantic": "q_up:out"}, {"id": "q_up:W", "shape": [24576, 1536], "dtype": "logical", "role": "parameter", "representation": "aggregate", "semantic": "q_up:W"}, {"id": "q_rope:out", "shape": ["B", "T", 128, 192], "dtype": "logical", "role": "activation", "representation": "aggregate", "semantic": "q_rope:out"}, {"id": "kv_down:out", "shape": ["B", "T", 576], "dtype": "logical", "role": "activation", "representation": "aggregate", "semantic": "kv_down:out"}, {"id": "kv_down:W", "shape": [576, 7168], "dtype": "logical", "role": "parameter", "representation": "aggregate", "semantic": "kv_down:W"}, {"id": "k_rope:out", "shape": ["B", "T", 1, 64], "dtype": "logical", "role": "activation", "representation": "aggregate", "semantic": "k_rope:out"}, {"id": "kv_norm:out", "shape": ["B", "T", 512], "dtype": "logical", "role": "activation", "representation": "aggregate", "semantic": "kv_norm:out"}, {"id": "kv_norm:gamma", "shape": [512], "dtype": "logical", "role": "parameter", "representation": 